# Backend API (no trailing slash).
# Local dev: leave unset — defaults to http://localhost:8000
# Vercel production: set API_BASE_URL to your Render URL (server-side proxy, no CORS issues)
API_BASE_URL=http://localhost:8000
# Optional: direct browser → API calls (skips proxy). Requires CORS_ORIGINS on Render.
# NEXT_PUBLIC_API_BASE_URL=https://your-service.onrender.com
